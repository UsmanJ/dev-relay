# Copy to .env.local (git-ignored). Everything here is optional; DevRelay needs NO API keys.

# Where DevRelay keeps its SQLite DB, worktrees and handoff files (default: ./data)
# DEVRELAY_DATA_DIR=C:\Users\you\DevRelay-data

# Override CLI locations if they are not on PATH:
# DEVRELAY_CODEX_BIN=C:\path\to\codex.exe
# DEVRELAY_CLAUDE_BIN=C:\path\to\claude.exe

# Automated Claude Code execution is OFF by default and enabled only through the one-time
# acknowledgement (Providers page or `npm run relay -- claude-automation enable`).
# Set this to forbid automated Claude runs entirely, even if acknowledged:
# DEVRELAY_DISABLE_CLAUDE_CLI=1

# Block every non-mock provider and skip provider status checks (used by CI and tests):
# DEVRELAY_OFFLINE=1

# API-metered (pay-per-use) provider adapters are disabled. None ship with DevRelay.
# Do not set this unless you add such an adapter and accept the charges:
# DEVRELAY_ALLOW_METERED_PROVIDERS=1
